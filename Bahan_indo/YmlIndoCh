name: Auto Update IndoCh

on:
  schedule:
    - cron: '*/15 * * * *'  # Berjalan otomatis setiap 15 menit sekali
  workflow_dispatch:

jobs:
  update:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Run script
        run: python IndoCh.py

      - name: Commit changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add "Sumber Indo/" "Sumber perKategori/" PlaylistINDOpilihan.m3u
          git commit -m "Real-time auto-update playlist & kategori [skip ci]" || exit 0
          git push
